# GreenProof environment configuration
GREENPROOF_BACKEND_ADDR=0.0.0.0:8080
GREENPROOF_SCRIPTS_DIR=../scripts
GREENPROOF_VKEY_PATH=../circuits/build/verification_key.json
RUST_LOG=info

# ESA WorldCover 2021 v200 public WMS. No credential required.
GREENPROOF_WORLDCOVER_WMS_URL=https://titiler.terrascope.be/wms

# Global Forest Watch Data API.
# Required for live Hansen/UMD tree-cover-loss verification.
# Create an account/API key using the official GFW Data API documentation.
# Never commit the real key.
GLOBAL_FOREST_WATCH_API_KEY=

# Optional AI audit keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend
VITE_BACKEND_URL=http://localhost:8080
