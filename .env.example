# GreenProof - environment configuration template
# Copy to .env and fill in real values. Never commit the real .env file.

# --- Backend ---
GREENPROOF_BACKEND_ADDR=0.0.0.0:8080
GREENPROOF_SCRIPTS_DIR=../scripts
GREENPROOF_VKEY_PATH=../circuits/build/verification_key.json
RUST_LOG=info

# --- Optional: Copernicus Data Space Ecosystem (CDSE) credentials ---
# Not wired into this MVP's request path yet (see backend/src/geo.rs module
# docs / README "Limitations"). Required only if/when Copernicus tree-cover
# density integration is implemented as future work. Register at
# https://dataspace.copernicus.eu/ to obtain these.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# --- Optional: Protected Planet / WDPA API ---
# Get a token at https://api.protectedplanet.net/ if you want to replace or
# supplement the OSM Overpass protected-area proxy used by this MVP with the
# official WDPA dataset (see README "Real data sources").
PROTECTED_PLANET_API_TOKEN=

# --- Frontend ---
VITE_BACKEND_URL=http://localhost:8080
